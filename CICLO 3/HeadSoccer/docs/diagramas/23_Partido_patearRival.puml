@startuml
mainframe sd patearRival
hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign left

participant ": Partido" as P
participant "jugador : Jugador" as J
participant "rival : Jugador" as R

[-> P : 1: patearRival(jugador) : void
activate P
P -> J : 1.1: estaPateando() : boolean
opt estaPateando
  P -> P : 1.2: rival = getRival(jugador) : Jugador
  opt distancia < 2 * RADIO + ALCANCE_PATADA
    P -> J : 1.3: getMultiplicadorKick() : double
    P -> R : 1.4: recibirDano(DANO_PATADA * multiplicadorKick) : void
    P -> J : 1.5: consumirPatada() : void
  end
end
deactivate P
@enduml
