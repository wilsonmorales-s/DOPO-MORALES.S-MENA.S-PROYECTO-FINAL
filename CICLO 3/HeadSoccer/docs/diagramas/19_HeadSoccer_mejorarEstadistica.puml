@startuml
mainframe sd mejorarEstadistica
hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign left

actor ": Actor0" as A
participant ": HeadSoccer" as H
participant ": Progreso" as PR
participant ": Estadisticas" as E

A -> H : 1: mejorarEstadistica(nombre, estadistica) : void
activate H
H -> H : 1.1: validarNombre(nombre) : void
alt estadistica != null
  H -> PR : 1.2: mejorar(nombre, estadistica) : void
  activate PR
  PR -> PR : 1.2.1: registrar(nombre) : void
  PR -> E : 1.2.2: getNivel(estadistica) : int
  alt nivel < NIVEL_MAXIMO
    PR -> PR : 1.2.3: precio = getPrecioMejora(nombre, estadistica) : int
    alt puntos >= precio
      PR -> E : 1.2.4: subir(estadistica) : void
    else otherwise
    end
  else otherwise
  end
  deactivate PR
  H -> H : 1.3: guardarProgreso() : void
else otherwise
end
deactivate H
@enduml
